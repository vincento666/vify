# Hify MySQL8 + Weaviate demo profile

HIFY_DATABASE_URL=mysql+pymysql://hify:hify@127.0.0.1:3306/hify?charset=utf8mb4
HIFY_VECTOR_STORE=weaviate
HIFY_WEAVIATE_URL=http://127.0.0.1:8080

# Keep local demo/runtime tests deterministic unless explicitly testing live LLM routing.
HIFY_RUNTIME_LAB_INTENT_ARBITRATOR_MODE=fake

# Empty binding uses the mock SOP adapter. If you seed RuntimeLab Chatflow demo
# data into this MySQL database, replace this with the fresh IDs from the seed
# output. Do not reuse IDs from another database.
HIFY_RUNTIME_LAB_SOP_CHATFLOW_IDS=

# Optional:
# HIFY_REDIS_URL=redis://127.0.0.1:6379/0
# HIFY_LOG_LEVEL=INFO
